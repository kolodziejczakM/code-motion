---
import { hrefFor } from "../content";
import SiteFooter from "../components/SiteFooter.astro";
import "../../prototypes/tower-lady/portfolio.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const colors = [
  ["Czerń", "#000000", "Tło strony głównej i O nas"],
  ["Grafit", "#101010", "Tło Filmów i wygaszenie kadru"],
  ["Kość słoniowa", "#F5EBD3", "Nagłówki, tekst i znak"],
  ["Ciepły szary", "#D8CEBB", "Metadane, opisy i stopka"],
  ["Mosiądz", "#BD9B5F", "Główne przyciski"],
  ["Przygaszone złoto", "#9A8459", "Linie i separatory"],
  ["Ślady cegieł", "#B8986C", "Bazowy kolor linii przy kryciu 19%"],
  ["Jasne złoto", "#F0CA80", "Linki w tekście"],
  ["Obrys fokusu", "#F5D499", "Wskaźnik nawigacji klawiaturą"],
  ["Tekst przycisku", "#090704", "Napis na mosiężnym tle"],
  ["Akcent po najechaniu", "#D6B67C", "Tło głównego przycisku po najechaniu"],
];

const typography = [
  ["Hero strony głównej", "Cormorant Garamond · 600", "41–100 px", "Niezależne krótkie metraże", "serif"],
  ["Tytuł filmu wyróżnionego", "Cormorant Garamond · 600 · kursywa", "57–140 px", "Boundless, actually", "italic"],
  ["Tytuł artykułu", "Cormorant Garamond · 600", "48–88 px", "Historia Tower Lady Pictures", "serif"],
  ["Nagłówki sekcji filmowych", "Cormorant Garamond · 600 · kursywa", "33–50 px", "Więcej krótkich metraży", "italic"],
  ["Tytuły kart filmów", "Cormorant Garamond · 600 · kursywa", "26–61 px", "Saturday cleaning", "italic"],
  ["Śródtytuły i wstęp artykułu", "Cormorant Garamond · 600", "28–42 px", "Nazwa z Szamotuł", "serif"],
  ["Tekst główny", "Inter · 400", "16–17 px", "Kręcimy niezależne filmy krótkometrażowe w Polsce.", "body"],
  ["Nawigacja", "Inter · 400", "15–24 px", "Filmy · O nas · EN", "body"],
  ["Logotyp", "Inter · 700 · wersaliki", "12–29 px", "TOWER LADY", "button-text"],
  ["Przyciski", "Inter · 700", "16–28 px", "Zobacz filmy", "button-text"],
  ["Metadane i stopka", "Inter · 400", "14–25 px", "2025 · Thriller / Absurd · 4:40", "body"],
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design system - Tower Lady Pictures</title>
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  </head>
  <body>
    <main id="top" class="design wrap" tabindex="-1">
      <a class="text-link" href={hrefFor("pl", "home")}>← Tower Lady Pictures</a>
      <h1>Design system</h1>

      <section aria-labelledby="colors">
        <h2 id="colors">Paleta</h2>
        <ul class="palette">
          {colors.map(([name, hex, usage]) => (
            <li>
              <span class="swatch" style={`--swatch: ${hex}`} aria-hidden="true"></span>
              <strong>{name}</strong>
              <code>{hex}</code>
              <p>{usage}</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="type">
        <h2 id="type">Typografia</h2>
        <p>Cormorant Garamond buduje hierarchię. Inter obsługuje dłuższą lekturę, nawigację i elementy interaktywne. Obie rodziny są hostowane lokalnie i mają polskie znaki. Cormorant Garamond ma je również w kursywie.</p>
        <dl class="type">
          {typography.map(([role, font, size, example, style]) => (
            <div>
              <dt>{role}</dt>
              <dd class="type-spec">{font} · {size}</dd>
              <dd class:list={["type-example", style]}>{example}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section aria-labelledby="layout">
        <h2 id="layout">Układ i ruch</h2>
        <ul class="guidelines">
          <li>Maksymalna szerokość układu wynosi 1480 px. Marginesy boczne rosną od 20 do 72 px. Artykuł ma szerokość do 67 znaków według jednostki <code>ch</code>.</li>
          <li>Stałe miejsce po stronie paska przewijania (<code>scrollbar-gutter: stable</code>) utrzymuje położenie logo, nawigacji i treści przy przechodzeniu między krótkimi i długimi podstronami.</li>
          <li>Tekst artykułu ma interlinię 1,74, a opisy filmów 1,6. Przyciski i linki w nawigacji mają co najmniej 44 px wysokości. Poniżej 341 px nawigacja dostaje osobny rząd pod logo.</li>
          <li>Na czarnym tle jest dziewięć fragmentów muru na szerokim ekranie i osiem na telefonie. Ciepła poświata przesuwa się łagodnie, po 28 s w każdą stronę.</li>
          <li>Na stronie głównej dolne pasma włosów Halszki poruszają się w cyklu 5,5 s. Ustawienie ograniczonego ruchu wyłącza ruch włosów, światła i przejścia między stronami.</li>
          <li>Natywne przejście między stronami trwa 160 ms. Logo w nagłówku zachowuje pozycję i skalę.</li>
          <li>Stopka ma nazwę studia prowadzącą na stronę główną, trzy wyśrodkowane ikony kontaktowe i odnośnik do góry strony. Pola ikon mają 44 × 44 px i dostępne nazwy. Na telefonie elementy są ułożone pionowo w kolejności nawigacji klawiaturą.</li>
        </ul>
        <div class="examples">
          <a class="button" href={hrefFor("pl", "films")}>Zobacz filmy</a>
          <a class="text-link" href={hrefFor("pl", "about")}>Poznaj historię studia</a>
        </div>
      </section>
    </main>
    <SiteFooter locale="pl" />
  </body>
</html>

<style>
  .design { padding-block: clamp(2rem, 6vw, 5rem); max-width: 72rem; }
  h1, h2 { font: 600 clamp(2rem, 5vw, 4.25rem) / 1 var(--serif); }
  h1 { margin-block: 1.1rem 2rem; }
  h2 { margin-bottom: .8rem; }
  section + section { margin-top: clamp(2.5rem, 5.5vw, 4.5rem); }
  p { max-width: 64ch; color: var(--muted); line-height: 1.6; }
  .palette { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: .9rem; padding: 0; list-style: none; }
  .palette li, .type > div { padding: 1rem; border: 1px solid #312b21; background: #101010; }
  .swatch { display: block; height: 4rem; margin-bottom: .75rem; border: 1px solid #574b36; background: var(--swatch); }
  .palette strong, .palette code { display: block; }
  .palette code { margin-block: .25rem; color: var(--brass); }
  .palette p { font-size: .9rem; }
  .type { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: .9rem; }
  .type dt { font-weight: 700; }
  .type dd { margin: 0; }
  .type-spec { padding-block: .3rem .7rem; color: var(--muted); font-size: .9rem; }
  .type-example.serif, .type-example.italic { font: 600 clamp(1.65rem, 3.6vw, 2.45rem) / 1.05 var(--serif); }
  .type-example.italic { font-style: italic; }
  .button-text { font-weight: 700; }
  .guidelines { display: grid; gap: .7rem; max-width: 70ch; padding-inline-start: 1.25rem; color: var(--muted); line-height: 1.6; }
  .examples { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 1.3rem; }
</style>
