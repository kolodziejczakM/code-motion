---
import { hrefFor } from "../content";
import "../../prototypes/tower-lady/portfolio.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Nie znaleziono strony · Page not found - Tower Lady Pictures</title>
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="32x32" />
  </head>
  <body>
    <main class="missing wrap">
      <div>
        <h1>Nie znaleziono strony</h1>
        <p lang="en">Page not found</p>
        <nav aria-label="Wróć na stronę główną">
          <a class="button" href={hrefFor("pl", "home")}>Wróć na stronę główną</a>
          <a class="text-link" href={hrefFor("en", "home")} lang="en">Back to home</a>
        </nav>
      </div>
    </main>
  </body>
</html>

<style>
  .missing { display: grid; place-items: center; padding-block: 2rem; }
  h1 { max-width: 18ch; font: 600 clamp(2.6rem, 7vw, 5rem) / 1 var(--serif); }
  p { margin-top: .75rem; color: var(--muted); }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.6rem; }
</style>
