---
import { copy, hrefFor, type Locale } from "../content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const contacts = [
  {
    name: "Facebook",
    href: "https://www.facebook.com/CODE.MOTION.FILM/",
    label: "Facebook - Tower Lady Pictures",
  },
  {
    name: "WhatsApp",
    href: "https://wa.me/48576142399",
    label: "WhatsApp - Marcin Kołodziejczak",
  },
  {
    name: "YouTube",
    href: "https://www.youtube.com/@code-motion1156",
    label: "YouTube - Tower Lady Pictures",
  },
];
---

<footer id="footer" class="site-footer wrap">
  <div class="footer-content">
    <a class="footer-home" href={hrefFor(locale, "home")} aria-label={t.homeLabel}>Tower Lady Pictures</a>
    <nav class="footer-contact" aria-label={t.footer.contact}>
      <ul class="footer-socials" role="list">
        {contacts.map(contact => (
          <li>
            <a class="footer-social-link" href={contact.href} aria-label={contact.label} title={contact.label}>
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                {contact.name === "Facebook" && (
                  <path d="M14 21v-8h3l.5-4H14V7c0-1 .5-1.5 1.7-1.5H18V2.2L15.1 2C12 2 10 3.9 10 7v2H7v4h3v8Z" fill="currentColor" />
                )}
                {contact.name === "YouTube" && (
                  <>
                    <rect x="2.5" y="5" width="19" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <path d="m10 9 5 3-5 3Z" fill="currentColor" />
                  </>
                )}
                {contact.name === "WhatsApp" && (
                  <>
                    <path d="M4 17.5 2.5 22 7 20.5a9 9 0 1 0-3-3Z" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <path d="m8 7 2 3-1 1c1 2 2 3 4 3l1-1 3 2c-1 4-6 2-8 0S4 8 8 7Z" fill="currentColor" />
                  </>
                )}
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="footer-top" href="#top">
      {t.footer.top}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 19V5m-6 6 6-6 6 6" />
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: .75rem 1.25rem;
  }
  .footer-home, .footer-top {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .footer-home { justify-self: start; }
  .footer-contact { justify-self: center; }
  .footer-socials {
    display: flex;
    align-items: center;
    gap: .625rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-social-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #9a845940;
    border-radius: 50%;
    color: var(--muted);
    text-decoration: none;
  }
  .footer-social-link:hover {
    border-color: var(--brass);
    background: #bd9b5f14;
    color: var(--ivory);
  }
  .footer-top { justify-self: end; gap: .4rem; white-space: nowrap; }
  .footer-home:hover, .footer-top:hover {
    color: var(--ivory);
    text-decoration: underline;
    text-underline-offset: .25em;
  }
  @media (max-width: 620px) {
    .footer-content { grid-template-columns: minmax(0, 1fr); gap: .5rem; }
    .footer-home, .footer-contact, .footer-top { justify-self: center; }
  }
</style>
