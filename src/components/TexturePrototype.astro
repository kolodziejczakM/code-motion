<!-- Throwaway prototype: compare A–D on the existing pages using ?variant=. -->
<style is:inline>
  :root[data-texture] body {
    --texture-color: 0 0 0;
  }

  :root[data-texture] .films-page {
    --texture-color: 16 16 16;
  }

  :root[data-texture="B"] body,
  :root[data-texture="C"] body {
    background-image:
      linear-gradient(rgb(var(--texture-color) / var(--texture-cover)), rgb(var(--texture-color) / var(--texture-cover))),
      var(--texture-tile);
    background-size: auto, var(--texture-size);
  }

  :root[data-texture="B"] body {
    --texture-cover: .88;
    --texture-size: 620px;
    --texture-tile: url("/prototypes/tower-lady/texture-prototype/film-grain.webp");
  }

  :root[data-texture="C"] body {
    --texture-cover: .61;
    --texture-size: 820px;
    --texture-tile: url("/prototypes/tower-lady/texture-prototype/matte-paper.webp");
  }

  :root[data-texture="D"] body {
    background-image:
      radial-gradient(ellipse min(78vw, 70rem) 45rem at 47% 34rem, rgb(147 107 66 / 14%), transparent 100%);
  }

  :root[data-texture]:not([data-texture="A"]) .featured {
    --texture-fade: linear-gradient(to bottom, #000 72%, transparent 100%);
  }

  :root[data-texture]:not([data-texture="A"]) .featured-still {
    mask-image: linear-gradient(to right, transparent, #000 23%), var(--texture-fade);
    mask-composite: intersect;
  }

  :root[data-texture]:not([data-texture="A"]) .featured::after {
    mask-image: var(--texture-fade);
  }

  @media (max-width: 620px) {
    :root[data-texture]:not([data-texture="A"]) .featured-still {
      mask-image: var(--texture-fade);
    }
  }

  .texture-switcher {
    position: fixed;
    z-index: 4;
    inset-inline-start: 50%;
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    max-width: calc(100% - 1.5rem);
    padding: .25rem;
    border: 1px solid #647176;
    border-radius: .65rem;
    background: #1a2529;
    color: #eef4f4;
    box-shadow: 0 3px 14px #0008;
    font: 500 .875rem/1.25 system-ui, sans-serif;
  }

  .texture-switcher button,
  .texture-switcher select {
    min-height: 44px;
    min-width: 44px;
    border: 0;
    border-radius: .35rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .texture-switcher button { font-size: 1.15rem; }
  .texture-switcher select { background-color: #253438; padding-inline: .5rem; }
  .texture-switcher button:hover { background-color: #34464c; }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const polish = root.lang === "pl";
    const labels = polish
      ? ["Czerń (obecna)", "Ziarno 35 mm", "Matowy papier", "Poświata projektora"]
      : ["Black (current)", "35 mm grain", "Matte paper", "Projector glow"];
    const variants = ["A", "B", "C", "D"];
    const address = new URL(location.href);
    const initial = address.searchParams.get("variant");
    if (!variants.includes(initial)) return;

    root.dataset.texture = initial;

    document.addEventListener("DOMContentLoaded", () => {
      const bar = document.createElement("div");
      bar.className = "texture-switcher";
      bar.setAttribute("role", "group");
      bar.setAttribute("aria-label", polish ? "Warianty tła" : "Background variants");
      bar.innerHTML = `
        <button type="button" data-step="-1" aria-label="${polish ? "Poprzednie tło" : "Previous background"}">←</button>
        <select aria-label="${polish ? "Wariant tła" : "Background variant"}">
          ${variants.map((variant, index) => `<option value="${variant}">${variant} · ${labels[index]}</option>`).join("")}
        </select>
        <button type="button" data-step="1" aria-label="${polish ? "Następne tło" : "Next background"}">→</button>
      `;
      document.body.append(bar);
      const select = bar.querySelector("select");
      const links = [...document.querySelectorAll('a[href^="/prototypes/tower-lady/astro/"]')];

      function show(variant) {
        root.dataset.texture = variant;
        select.value = variant;
        address.searchParams.set("variant", variant);
        history.replaceState(history.state, "", address);
        for (const link of links) {
          const target = new URL(link.href);
          target.searchParams.set("variant", variant);
          link.href = target;
        }
      }

      function step(direction) {
        const index = variants.indexOf(select.value);
        show(variants[(index + direction + variants.length) % variants.length]);
      }

      for (const button of bar.querySelectorAll("button")) {
        button.addEventListener("click", () => step(Number(button.dataset.step)));
      }
      select.addEventListener("change", () => show(select.value));
      document.addEventListener("keydown", (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (event.target instanceof Element && event.target.closest("input, select, textarea, [contenteditable]")) return;
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        step(event.key === "ArrowLeft" ? -1 : 1);
      });
      show(initial);
    });
  })();
</script>
