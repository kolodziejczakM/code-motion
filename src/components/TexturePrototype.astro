<!-- Throwaway prototype: compare accents using ?variant=A–E or brick spacing using ?density=A–D. -->
<style is:inline>
  :root[data-texture]:not([data-texture="A"]) body {
    position: relative;
    isolation: isolate;
  }

  /* Let the illustration's screen blend reach the page behind it. */
  :root[data-texture]:not([data-texture="A"]) .home-hero {
    isolation: auto;
  }

  .texture-details {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  [data-texture="A"] .texture-details { display: none; }

  :is([data-texture="C"], [data-texture="D"], [data-texture="E"]) .texture-details::before {
    content: "";
    position: absolute;
    inset-block-start: -8rem;
    inset-inline-start: -8%;
    width: min(92rem, 115%);
    height: clamp(32rem, 74vh, 56rem);
    background: radial-gradient(
      ellipse 84% 86% at 16% 22%,
      rgb(171 137 83 / 15%),
      rgb(153 119 72 / 6%) 46%,
      transparent 84%
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-texture="E"] .texture-details::before {
      animation: texture-light-drift 28s ease-in-out infinite alternate;
    }

    @keyframes texture-light-drift {
      from { transform: translate(0, 0); opacity: 1; }
      to { transform: translate(4%, 3%); opacity: .82; }
    }
  }

  .texture-bricks {
    position: absolute;
    width: clamp(9rem, 17vw, 17rem);
    aspect-ratio: 3.2;
    color: rgb(184 152 108 / 19%);
    background:
      linear-gradient(currentColor 0 0) 22% 33% / 77% 1px,
      linear-gradient(currentColor 0 0) 75% 66% / 64% 1px,
      linear-gradient(currentColor 0 0) 28% 0 / 1px 33%,
      linear-gradient(currentColor 0 0) 59% 49% / 1px 34%,
      linear-gradient(currentColor 0 0) 39% 100% / 1px 34%,
      linear-gradient(currentColor 0 0) 76% 100% / 1px 34%;
    background-repeat: no-repeat;
    mask-image: radial-gradient(ellipse farthest-side, #000 32%, #000a 62%, transparent 100%);
  }

  [data-texture="C"] .texture-bricks { display: none; }

  .texture-bricks:nth-child(1) {
    inset-inline-start: clamp(1rem, 6vw, 10rem);
    inset-block-start: clamp(6.5rem, 10vh, 8.5rem);
  }

  .texture-bricks:nth-child(2) {
    inset-inline-end: clamp(.25rem, 3vw, 7rem);
    inset-block-start: 54%;
    transform: scaleX(-1) scale(.86);
    opacity: .83;
  }

  .texture-bricks:nth-child(3) {
    inset-inline-start: clamp(1rem, 10vw, 16rem);
    inset-block-end: 7.5rem;
    transform: scale(.73);
    opacity: .66;
  }

  .films-page .texture-bricks:nth-child(1) {
    inset-block-start: clamp(36.5rem, 44vw, 46rem);
  }

  /* Keep the added fragments in the margins and the free space above the footer. */
  [data-brick-density]:not([data-brick-density="A"]) .texture-bricks {
    --brick-inset: clamp(-3.5rem, (100% - var(--measure)) / 2 - 7rem, 12rem);
  }

  [data-brick-density]:not([data-brick-density="A"]) .texture-bricks:nth-child(2) {
    inset-inline-end: var(--brick-inset);
    inset-block-start: 49%;
  }

  [data-brick-density]:not([data-brick-density="A"]) .texture-bricks:nth-child(3) {
    inset-inline-start: var(--brick-inset);
    inset-block-end: 5rem;
    opacity: .83;
  }

  .texture-bricks:nth-child(4) {
    inset-inline-end: var(--brick-inset);
    inset-block-start: 26%;
    transform: scale(.9);
  }

  .texture-bricks:nth-child(5) {
    inset-inline-start: var(--brick-inset);
    inset-block-start: 42%;
    transform: scaleX(-1) scale(.84);
  }

  .texture-bricks:nth-child(6) {
    inset-inline-end: var(--brick-inset);
    inset-block-end: 7rem;
    transform: scale(.92);
  }

  .texture-bricks:nth-child(7) {
    inset-inline-end: calc(var(--brick-inset) - 1.5rem);
    inset-block-start: max(6rem, 14%);
    transform: scaleX(-1) scale(.68);
    opacity: .76;
  }

  .texture-bricks:nth-child(8) {
    inset-inline-start: calc(var(--brick-inset) - .75rem);
    inset-block-start: 63%;
    transform: scale(.82);
    opacity: .84;
  }

  .texture-bricks:nth-child(9) {
    inset-inline-end: calc(var(--brick-inset) - 1rem);
    inset-block-start: 72%;
    transform: scaleX(-1) scale(.73);
    opacity: .76;
  }

  :root[data-texture]:not([data-texture="A"]) .featured {
    --texture-fade: linear-gradient(to bottom, #000 72%, transparent 100%);
  }

  :root[data-texture]:not([data-texture="A"]) .featured-still {
    mask-image: linear-gradient(to right, transparent, #000 23%), var(--texture-fade);
    mask-composite: intersect;
  }

  :root[data-texture]:not([data-texture="A"]) .featured::after {
    mask-image: var(--texture-fade);
  }

  @media (max-width: 620px) {
    .texture-bricks:nth-child(1) {
      width: 8rem;
      inset-inline-start: auto;
      inset-inline-end: -2.5rem;
      inset-block-start: 4.6rem;
      opacity: .78;
    }
    .films-page .texture-bricks:nth-child(1) { inset-block-start: 33rem; }
    .texture-bricks:nth-child(3) { display: none; }
    [data-brick-density]:not([data-brick-density="A"]) .texture-bricks:nth-child(3) { display: block; }
    .texture-bricks:nth-child(6) { inset-block-end: 9rem; }
    .texture-bricks:nth-child(9) { display: none; }

    :root[data-texture]:not([data-texture="A"]) .featured-still {
      mask-image: var(--texture-fade);
    }
  }

  .texture-switcher {
    position: fixed;
    z-index: 4;
    inset-inline-start: 50%;
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    max-width: calc(100% - 1.5rem);
    padding: .25rem;
    border: 1px solid #647176;
    border-radius: .65rem;
    background: #1a2529;
    color: #eef4f4;
    box-shadow: 0 3px 14px #0008;
    font: 500 .875rem/1.25 system-ui, sans-serif;
  }

  .texture-switcher button,
  .texture-switcher select {
    min-height: 44px;
    min-width: 44px;
    border: 0;
    border-radius: .35rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .texture-switcher button { font-size: 1.15rem; }
  .texture-switcher select { background-color: #253438; padding-inline: .5rem; }
  .texture-switcher button:hover { background-color: #34464c; }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const polish = root.lang === "pl";
    const address = new URL(location.href);
    const density = address.searchParams.has("density");
    const parameter = density ? "density" : "variant";
    const backgroundLabels = polish
      ? ["Czerń (obecna)", "Ślady cegieł", "Ciepła poświata", "Cegły i światło", "Cegły i ruch światła"]
      : ["Black (current)", "Brick traces", "Warm glow", "Brick and light", "Brick and drifting light"];
    const densityLabels = polish
      ? ["Obecny układ", "Rzadko", "Średnio", "Gęsto"]
      : ["Current layout", "Sparse", "Medium", "Dense"];
    const brickCounts = [3, 4, 6, 9];
    const labels = density ? densityLabels : backgroundLabels;
    const variants = ["A", "B", "C", "D", "E"].slice(0, labels.length);
    const initial = address.searchParams.get(parameter);
    if (!variants.includes(initial)) return;

    root.dataset.texture = density ? "E" : initial;

    document.addEventListener("DOMContentLoaded", () => {
      const brickFragment = '<span class="texture-bricks"></span>';
      const details = document.createElement("div");
      details.className = "texture-details";
      details.setAttribute("aria-hidden", "true");
      if (!density) details.innerHTML = brickFragment.repeat(3);
      document.body.prepend(details);

      const controlsLabel = density
        ? (polish ? "Gęstość cegieł" : "Brick density")
        : (polish ? "Wariant tła" : "Background variant");
      const bar = document.createElement("div");
      bar.className = "texture-switcher";
      bar.setAttribute("role", "group");
      bar.setAttribute("aria-label", controlsLabel);
      bar.innerHTML = `
        <button type="button" data-step="-1" aria-label="${polish ? "Poprzedni wariant" : "Previous variant"}">←</button>
        <select aria-label="${controlsLabel}">
          ${variants.map((variant, index) => `<option value="${variant}">${variant} · ${labels[index]}</option>`).join("")}
        </select>
        <button type="button" data-step="1" aria-label="${polish ? "Następny wariant" : "Next variant"}">→</button>
      `;
      document.body.append(bar);
      const select = bar.querySelector("select");
      const links = [...document.querySelectorAll('a[href^="/prototypes/tower-lady/astro/"]')];

      function show(variant) {
        if (density) {
          root.dataset.brickDensity = variant;
          details.innerHTML = brickFragment.repeat(brickCounts[variants.indexOf(variant)]);
        } else {
          root.dataset.texture = variant;
        }
        select.value = variant;
        address.searchParams.set(parameter, variant);
        history.replaceState(history.state, "", address);
        for (const link of links) {
          const target = new URL(link.href);
          target.searchParams.set(parameter, variant);
          link.href = target;
        }
      }

      function step(direction) {
        const index = variants.indexOf(select.value);
        show(variants[(index + direction + variants.length) % variants.length]);
      }

      for (const button of bar.querySelectorAll("button")) {
        button.addEventListener("click", () => step(Number(button.dataset.step)));
      }
      select.addEventListener("change", () => show(select.value));
      document.addEventListener("keydown", (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (event.target instanceof Element && event.target.closest("input, select, textarea, [contenteditable]")) return;
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        step(event.key === "ArrowLeft" ? -1 : 1);
      });
      show(initial);
    });
  })();
</script>
