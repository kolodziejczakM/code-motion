---
import type { HTMLAttributes } from "astro/types";
import { copy, type Locale } from "../content";

interface Props extends Omit<HTMLAttributes<"a">, "target" | "rel"> {
  href: string;
  locale: Locale;
  indicator?: "inline" | "corner";
}

const { locale, indicator = "inline", class: className, "aria-label": label, title, ...attributes } = Astro.props;
const hint = copy[locale].opensInNewTab;
---

<a
  {...attributes}
  class:list={["external-link", className]}
  target="_blank"
  rel="noopener"
  data-indicator={indicator}
  aria-label={label ? `${label} (${hint})` : undefined}
  title={title ? `${title} (${hint})` : hint}
>
  <slot /><span class="new-tab-notice"><svg class="new-tab-icon" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 11 13 3M6 3h7v7" /></svg>{!label && <span class="new-tab-hint"> ({hint})</span>}</span>
</a>

<style>
  .new-tab-notice { display: inline-block; margin-inline-start: .25em; white-space: nowrap; line-height: 1; }
  .new-tab-icon {
    display: inline-block;
    width: var(--new-tab-icon-size, .75rem);
    height: var(--new-tab-icon-size, .75rem);
    vertical-align: -.05em;
  }
  .new-tab-hint {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .external-link[data-indicator="corner"] { position: relative; }
  [data-indicator="corner"] .new-tab-notice {
    position: absolute;
    inset-block-start: var(--new-tab-inset, .4rem);
    inset-inline-end: var(--new-tab-inset, .4rem);
    display: grid;
    place-items: center;
    width: var(--new-tab-marker-size, 1.25rem);
    height: var(--new-tab-marker-size, 1.25rem);
    margin: 0;
    border-radius: 2px;
    background: var(--new-tab-marker-background, #000a);
  }
</style>
