---
import { copy, hrefFor, type Locale } from "../content";
import { aboutStory, festivalAppearances } from "../about";
import { films } from "../films";
import FilmEmbed from "./FilmEmbed.astro";
import ExternalLink from "./ExternalLink.astro";
import HeadingLink from "./HeadingLink.astro";
import ReadingProgress from "./ReadingProgress.astro";
import StoryFigure from "./StoryFigure.astro";
import scenePlan from "../assets/about/boundless-scene-plan.gif?url";
import scenePlanPoster from "../assets/about/boundless-scene-plan-poster.webp";
import akabeiTests from "../assets/about/akabei-test-shoot.jpg";
import screening from "../assets/about/boundless-screening.jpg";
import submissions from "../assets/about/filmfreeway-submissions.png";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const meta = copy[locale].about;
const t = aboutStory[locale];
const contactLinks = [
  { label: t.contact.email, href: "mailto:kolodziejczak.mn@gmail.com" },
  { label: "Telegram", href: "https://t.me/kolodziejczakM" },
  { label: "WhatsApp", href: "https://wa.me/48576142399" },
  { label: "Facebook", href: "https://www.facebook.com/CODE.MOTION.FILM/" },
];
---

<ReadingProgress />
<main id="main" class="wrap">
  <article class="studio-story" aria-labelledby="story-title" data-reading-content>
    <p class="reading-time">{meta.readingTime}</p>
    <h1 id="story-title">{meta.heading}</h1>
    <div class="studio-intro">
      {meta.intro.map(paragraph => <p class="story-intro">{paragraph}</p>)}
    </div>
    <p class="studio-origin">{t.origin}</p>

    <section aria-labelledby="studio-history">
      <h2 id="studio-history"><HeadingLink id="studio-history" text={t.history.heading} locale={locale} /></h2>
      {t.history.entries.map(entry => {
        const film = films.find(film => film.id === entry.filmId);
        return (
          <div class="studio-history-entry">
            <p>{entry.parts.map(part => typeof part === "string" ? part : <ExternalLink locale={locale} class="text-link" href={part.href}>{part.label}</ExternalLink>)}</p>
            {film && <FilmEmbed film={film} locale={locale} />}
          </div>
        );
      })}
    </section>

    <section aria-labelledby="studio-approach">
      <h2 id="studio-approach"><HeadingLink id="studio-approach" text={t.approach.heading} locale={locale} /></h2>
      <p class="studio-byline">{t.approach.byline}</p>
      {t.approach.paragraphs.map((text, index) => (
        <Fragment>
          <p>{text}</p>
          {index === 0 && <StoryFigure image={scenePlanPoster} animation={scenePlan} alt={t.media.scenePlan.alt} caption={t.media.scenePlan.caption} locale={locale} />}
          {index === 1 && <StoryFigure image={akabeiTests} alt={t.media.akabeiTests.alt} caption={t.media.akabeiTests.caption} locale={locale} />}
        </Fragment>
      ))}
      <StoryFigure image={submissions} alt={t.media.submissions.alt} caption={t.media.submissions.caption} locale={locale} />
    </section>

    <section aria-labelledby="studio-team">
      <h2 id="studio-team"><HeadingLink id="studio-team" text={t.team.heading} locale={locale} /></h2>
      <div class="studio-team">
        {t.team.members.map(member => (
          <div class="studio-person">
            <h3 id={member.id}><HeadingLink id={member.id} text={member.name} locale={locale} /></h3>
            <p class="studio-role">{member.roles}</p>
            <p>{member.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="studio-festivals">
      <h2 id="studio-festivals"><HeadingLink id="studio-festivals" text={t.festivals.heading} locale={locale} /></h2>
      <StoryFigure image={screening} alt={t.media.screening.alt} caption={t.media.screening.caption} locale={locale} portrait />
      {festivalAppearances.map(group => {
        const film = films.find(film => film.id === group.filmId)!;
        return (
          <div class="studio-festival-group">
            <h3 id={`studio-festivals-${film.id}`}><ExternalLink locale={locale} class="text-link" href={film.url}>{t.filmTitles[film.id]}</ExternalLink><HeadingLink id={`studio-festivals-${film.id}`} text={t.filmTitles[film.id]} locale={locale} iconOnly /></h3>
            <ul class="studio-festivals" role="list">
              {group.entries.map(entry => (
                <li>
                  <span class="festival-name">{entry.festival}</span>
                  <span class="festival-result">{t.festivals.results[entry.result]}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </section>

    <section aria-labelledby="studio-contact">
      <h2 id="studio-contact"><HeadingLink id="studio-contact" text={t.contact.heading} locale={locale} /></h2>
      <p>{t.contact.text}</p>
      <ul class="studio-contact-links" role="list">
        {contactLinks.map(link => (
          <li>
            {link.href.startsWith("https://")
              ? <ExternalLink locale={locale} class="text-link" href={link.href}>{link.label}</ExternalLink>
              : <a class="text-link" href={link.href}>{link.label}</a>}
          </li>
        ))}
      </ul>
    </section>

    <a class="text-link story-link" href={hrefFor(locale, "films")}>{meta.explore}</a>
  </article>
</main>

<style>
  .studio-story .reading-time {
    margin-bottom: 1rem;
    font: 400 .8125rem / 1.6 var(--sans);
  }
  .studio-story :is(h1, h2, h3) { scroll-margin-top: 1rem; }
  .studio-intro .story-intro + .story-intro { margin-top: .65em; }
  .studio-origin { margin-top: 1.4rem; }
  .studio-story > section { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .studio-story > section > h2 {
    margin-block: 0 1.25rem;
    border-block-start: 1px solid var(--rule);
    padding-block-start: .75em;
  }
  .studio-history-entry + .studio-history-entry { margin-top: 1.6rem; }
  .studio-story p + p { margin-top: 1.1rem; }
  .studio-story .studio-byline {
    margin-block: -.55rem 1.5rem;
    font-size: .875rem;
    color: var(--brass);
  }
  .studio-story .studio-byline + p { margin-top: 0; }
  h3 {
    font: 600 clamp(1.65rem, 3vw, 2rem) / 1.2 var(--serif);
    margin-bottom: .35rem;
  }
  .studio-person + .studio-person { margin-top: 2rem; }
  .studio-story .studio-role {
    color: var(--brass);
    font-size: .8125rem;
    line-height: 1.6;
  }
  .studio-story .studio-role + p { margin-top: .6rem; }
  .studio-festival-group + .studio-festival-group { margin-top: 2rem; }
  .studio-festival-group h3 {
    display: flex;
    align-items: baseline;
    gap: .15rem;
    margin-bottom: .75rem;
  }
  .studio-festival-group h3 > :global(.external-link) { min-width: 0; }
  .studio-festivals { margin: 0; padding: 0; list-style: none; }
  .studio-festivals li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: .25rem 1.25rem;
    padding-block: .8rem;
    border-block-start: 1px solid #9a845940;
    line-height: 1.6;
  }
  .festival-name { flex: 1 1 17rem; color: var(--muted); font-size: .9375rem; }
  .festival-result { flex: 0 1 15rem; color: var(--ivory); font-size: .8125rem; }
  .studio-contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    font-size: .9375rem;
  }
  .studio-contact-links a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 620px) {
    .studio-festivals li { display: block; }
    .festival-name, .festival-result { display: block; }
    .festival-result { margin-top: .2rem; }
  }
</style>
