---
// Neutral grey preserves the image. The two fields only reach the loose locks.
const displacement = `
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 580">
    <defs>
      <radialGradient id="lower">
        <stop stop-color="rgb(245 197 128)" />
        <stop offset="1" stop-color="rgb(128 128 128)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="upper">
        <stop stop-color="rgb(55 172 128)" />
        <stop offset="1" stop-color="rgb(128 128 128)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="500" height="580" fill="rgb(128 128 128)" />
    <ellipse cx="44" cy="455" rx="83" ry="81" fill="url(#lower)" />
    <ellipse cx="61" cy="369" rx="91" ry="81" fill="url(#upper)" />
  </svg>`;
---

<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" aria-hidden="true">
  <filter id="hair-wind" x="0%" y="0%" width="100%" height="100%" primitiveUnits="objectBoundingBox" color-interpolation-filters="sRGB">
    <feImage href={`data:image/svg+xml,${encodeURIComponent(displacement)}`} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="wind" />
    <feDisplacementMap in="SourceGraphic" in2="wind" scale="0" xChannelSelector="R" yChannelSelector="G">
      <animate id="hair-wind-cycle" attributeName="scale" values="0;.022;.008;-.013;0"
        keyTimes="0;.28;.47;.75;1" calcMode="spline"
        keySplines=".42 0 .58 1;.42 0 .58 1;.42 0 .58 1;.42 0 .58 1"
        dur="11s" repeatCount="indefinite" begin="indefinite" />
    </feDisplacementMap>
  </filter>
</svg>

<style is:inline>
  @media (prefers-reduced-motion: no-preference) {
    :root[data-hair-motion] .home-art-graphic { filter: url(#hair-wind); }
  }
</style>
<script is:inline>
  if (new URLSearchParams(location.search).get("hair") === "on") {
    const preference = matchMedia("(prefers-reduced-motion: no-preference)");
    const cycle = document.getElementById("hair-wind-cycle");
    const update = () => {
      document.documentElement.toggleAttribute("data-hair-motion", preference.matches);
      if (preference.matches) cycle?.beginElement?.();
      else cycle?.endElement?.();
    };
    update();
    preference.addEventListener("change", update);
  }
</script>
