---
import type { Locale } from "../content";
import animation from "../scripts/hair-motion.js?raw";

interface Props {
  locale: Locale;
}

const polish = Astro.props.locale === "pl";
const labels = polish
  ? ["Statyczna", "Łagodny powiew", "Płynny wiatr", "Wyraźny podmuch"]
  : ["Still", "Gentle breeze", "Flowing wind", "Stronger gust"];
const controlLabel = polish ? "Animacja włosów" : "Hair animation";
---

<!-- Throwaway prototype. Open a home page with ?hair=A–D. -->
<div class="hair-preview-controls" data-hair-preview role="group" aria-label={controlLabel} hidden>
  <button type="button" data-step="-1" aria-label={polish ? "Poprzedni wariant" : "Previous variant"}>←</button>
  <select aria-label={controlLabel}>
    {["A", "B", "C", "D"].map((option, index) => <option value={option}>{option} · {labels[index]}</option>)}
  </select>
  <button type="button" data-step="1" aria-label={polish ? "Następny wariant" : "Next variant"}>→</button>
</div>

<style is:inline>
  .hair-preview-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hair-preview-controls[hidden] { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .hair-preview-canvas { display: none; }
  }

  .hair-preview-controls {
    position: fixed;
    z-index: 4;
    inset-inline-start: 50%;
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    max-width: calc(100% - 1.5rem);
    padding: .25rem;
    border: 1px solid #647176;
    border-radius: .65rem;
    background: #1a2529;
    color: #eef4f4;
    box-shadow: 0 3px 14px #0008;
    font: 500 .875rem/1.25 system-ui, sans-serif;
  }

  .hair-preview-controls button,
  .hair-preview-controls select {
    min-width: 44px;
    min-height: 44px;
    border: 0;
    border-radius: .35rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .hair-preview-controls button { font-size: 1.15rem; }
  .hair-preview-controls select { background-color: #253438; padding-inline: .5rem; }
  .hair-preview-controls button:hover { background-color: #34464c; }
</style>

<script is:inline type="module" set:html={animation}></script>
