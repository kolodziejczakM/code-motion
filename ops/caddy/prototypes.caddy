# CODE-MOTION prototypes: HTTPS within the tailnet.
# Append this block to /etc/caddy/Caddyfile; it is not a standalone config.
https://vps.tailfb5686.ts.net:8766 {
    bind 100.113.202.72 [fd7a:115c:a1e0::f601:caae]
    root * /home/marcin/repos/code-motion

    redir / /prototypes/naming.prototype.html?variant=A 302

    @preview path /prototypes/* /docs/rebranding/*
    handle @preview {
        header Cache-Control "no-store"
        file_server
    }

    handle {
        respond "Not found" 404
    }
}
