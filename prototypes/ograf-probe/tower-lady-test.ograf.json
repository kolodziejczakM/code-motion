{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "com.towerlady.resolve-compatibility-probe",
  "name": "Tower Lady - OGraf compatibility test",
  "description": "Transparent Canvas with a deterministic moving circle and host time counter. Compatibility probe, not the final logo.",
  "main": "graphic.mjs",
